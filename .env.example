# --- auth ---
SECRET_KEY=replace-with-a-secure-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- database ---
# Leave unset to use <project-root>/data/app.db. A relative path here resolves
# against the directory you launch uvicorn from, which is easy to get wrong.
# DB_PATH=./data/app.db

# --- api ---
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- code execution sandbox ---
# docker = each run gets a throwaway, network-less, read-only container (default).
# local  = bare subprocess on this host. NO isolation. Local development only.
EXECUTION_BACKEND=docker
EXECUTION_TIMEOUT_SECONDS=10
EXECUTION_MEMORY_LIMIT=256m
EXECUTION_CPU_LIMIT=0.5
EXECUTION_MAX_OUTPUT_BYTES=65536
EXECUTION_PIDS_LIMIT=64

# --- frontend ---
VITE_API_URL=http://localhost:8000
