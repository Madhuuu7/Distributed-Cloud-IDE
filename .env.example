# --- auth ---
SECRET_KEY=replace-with-a-secure-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- database ---
# Leave unset to use <project-root>/data/app.db. A relative path here resolves
# against the directory you launch uvicorn from, which is easy to get wrong.
# DB_PATH=./data/app.db

# --- api ---
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- code execution sandbox ---
# docker = each run gets a throwaway, network-less, read-only container (default).
# local  = bare subprocess on this host. NO isolation. Local development only.
EXECUTION_BACKEND=docker
EXECUTION_TIMEOUT_SECONDS=10
EXECUTION_MEMORY_LIMIT=256m
EXECUTION_CPU_LIMIT=0.5
EXECUTION_MAX_OUTPUT_BYTES=65536
EXECUTION_PIDS_LIMIT=64

# --- frontend ---
VITE_API_URL=http://localhost:8000

# --- AI providers -----------------------------------------------------------
# mock | anthropic | gemini | ollama
# "mock" is the default and needs no key: responses are generated locally, the
# whole app and its test suite run at zero cost, and only the quality of the
# prose is fake - retrieval, streaming, caching and accounting all run for real.
AI_PROVIDER=mock

# Resolved separately, because the best generation model often comes from a
# vendor with no embeddings endpoint (Anthropic has none).
AI_EMBEDDING_PROVIDER=mock

AI_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT_SECONDS=120
AI_CACHE_MAX_ENTRIES=512
AI_CACHE_TTL_SECONDS=3600
AI_RATE_LIMIT_PER_MINUTE=20

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Set these from your provider's current price list to keep /ai/usage honest.
# USD per million tokens. Left blank, the built-in defaults for the configured
# model are used.
AI_PRICE_PROMPT_PER_MTOK=
AI_PRICE_COMPLETION_PER_MTOK=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Retrieval --------------------------------------------------------------
RAG_MAX_CHUNK_LINES=60
RAG_CHUNK_OVERLAP_LINES=10
RAG_TOP_K=6
# Keyword search nails exact identifiers; vector search generalises. Neither is
# sufficient alone, so results are a weighted blend of the two.
RAG_KEYWORD_WEIGHT=0.3
RAG_VECTOR_WEIGHT=0.7

# --- Agentic fix loop -------------------------------------------------------
FIX_MAX_ITERATIONS=3
# Hard ceiling a request body cannot exceed - a model that misreads a failure
# will otherwise retry until the budget is gone.
FIX_ITERATION_CEILING=10
